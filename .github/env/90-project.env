# ================================================================================================
# 🏗️ PROJECT-SPECIFIC OVERRIDES (90-project.env)
# ================================================================================================
#
# Purpose: Project-specific configuration overrides for BSV Broadcaster
# Load Order: 90 (loaded after all defaults, overrides earlier files)
#
# This file contains settings specific to this repository that should NOT be synced
# to other repositories via go-broadcast. All values here override defaults from
# earlier env files (00-core, 10-*, 20-*).
#
# ================================================================================================

# ================================================================================================
# 🎯 GO VERSION CONFIGURATION (overrides 00-core.env)
# ================================================================================================

GO_PRIMARY_VERSION=1.27.x
GO_SECONDARY_VERSION=1.27.x

# ================================================================================================
# 🪄 MAGE-X VERSION OVERRIDES (overrides 10-mage-x.env)
# ================================================================================================

MAGE_X_GO_VERSION=1.27.x
MAGE_X_GO_SECONDARY_VERSION=1.27.x

# ================================================================================================
# 📊 COVERAGE CONFIGURATION (overrides 10-coverage.env)
# ================================================================================================

# Coverage provider (codecov for this project)
GO_COVERAGE_PROVIDER=codecov

# Codecov Configuration
CODECOV_TOKEN_REQUIRED=true

# Coverage exclusion paths (matches codecov.yml ignore list + standard exclusions)
GO_COVERAGE_EXCLUDE_PATHS=.github/,.mage-cache/,.vscode/,bin/,example/,examples/,mocks/,testing/,test/,vendor/,testdata/

# ================================================================================================
# 🔒 SECURITY CVE EXCLUSIONS (overrides 10-security.env)
# ================================================================================================

# Nancy CVE Exclusions
# CVE-2026-45045 (gofiber/fiber/v2) and CVE-2026-54908 (pion/dtls/v2) are transitive-only
# modules (via go-chaintracks and go-libp2p-pubsub respectively) that are not reachable in
# our binaries -- govulncheck (symbol-level) reports clean. Nancy flags the whole module
# graph, so they are excluded here until the upstream deps drop/patch them.
# Appended 2026-08-03 (PR #272, post deps:update-all):
#  - CVE-2026-54909 (pion/stun, DoS panic parsing malformed STUN attrs) is a
#    transitive-only module via go-libp2p-pubsub, not reachable in our binaries.
#  - CVE-2026-54787 (sigstore/sigstore-go, expired signing key acceptance) is a
#    transitive-only module via bsv-blockchain/teranode, not reachable in our binaries.
#  Both report clean under govulncheck (symbol-level); excluded until upstream patches land.
NANCY_EXCLUDES=CVE-2024-38513,CVE-2023-45142,CVE-2025-64702,CVE-2021-43668,CVE-2023-26248,CVE-2026-24051,CVE-2026-26014,CVE-2026-26958,CVE-2025-15558,CVE-2026-4427,CVE-2026-33809,CVE-2026-32286,CVE-2026-33747,CVE-2026-33748,CVE-2026-34986,CVE-2026-33815,CVE-2026-33816,CVE-2026-35469,CVE-2026-5160,CVE-2026-39882,CVE-2026-33813,CVE-2026-33812,CVE-2026-46599,CVE-2026-42500,CVE-2026-53488,CVE-2026-53489,CVE-2026-53492,CVE-2026-47262,CVE-2026-50195,CVE-2026-46601,CVE-2026-46602,CVE-2026-46604,CVE-2026-45045,CVE-2026-54908,CVE-2026-53624,CVE-2026-15789,CVE-2026-15792,CVE-2026-15788,CVE-2026-49834,CVE-2026-15791,CVE-2026-54909,CVE-2026-54787

# Govulncheck/Magex CVE Exclusions
# Appended 2026-07-08 (pre-existing on main, unrelated to app-level changes):
#  - CVE-2026-42505 (crypto/tls ECH privacy leak) and CVE-2026-39822 (os symlink
#    root-escape) are Go stdlib issues fixed in go1.26.5. go.mod pins `go 1.26.3`
#    and CI runs GOTOOLCHAIN=local, so bumping the toolchain in-repo would break
#    the build; excluded here until the runner Go version is raised to >=1.26.5.
#  - GO-2026-5932 (golang.org/x/crypto/openpgp unmaintained/unsafe) is a
#    transitive, non-reachable advisory with no upstream fix (package is deprecated).
# Appended 2026-10-06 (PR #360, gomod-all bump):
#  - CVE-2026-84445 / GO-2026-6443 (grpc-go panic on an RPC missing :authority and
#    Host) only crashes servers built with xds.NewGRPCServer(). BSV Broadcaster links no
#    google.golang.org/grpc/xds or internal/xds package, so the panic path is not
#    in our binaries. go-chaintracks v1.4.1 and grpc-gateway v2.31.0 require grpc
#    >= v1.84.0, and v1.84.0 shipped without the fix (it is only in 1.82.2,
#    1.83.2 and the unreleased 1.85.0-dev). Remove once grpc v1.84.1+ is released.
# Appended 2026-11-11: CVE-2026-118651 / CVE-2026-118653 (echo v4, see the shared
#    exclusions below). govulncheck (`magex deps:audit`) reads only this variable,
#    not SECURITY_VULN_EXCLUDES, so they must be listed here too.
MAGE_X_CVE_EXCLUDES=CVE-2024-38513,CVE-2023-45142,CVE-2025-64702,CVE-2021-43668,CVE-2023-26248,CVE-2026-24051,CVE-2026-26014,CVE-2026-26958,CVE-2025-15558,CVE-2026-4427,CVE-2026-33809,CVE-2026-32286,CVE-2026-33747,CVE-2026-33748,CVE-2026-34986,CVE-2026-33815,CVE-2026-33816,CVE-2026-35469,CVE-2026-5160,CVE-2026-39882,CVE-2026-33813,CVE-2026-33812,CVE-2026-46599,CVE-2026-42500,CVE-2026-53488,CVE-2026-53489,CVE-2026-53492,CVE-2026-47262,CVE-2026-50195,CVE-2026-46601,CVE-2026-46602,CVE-2026-46604,CVE-2026-45045,CVE-2026-54908,CVE-2026-42505,CVE-2026-39822,GO-2026-5932,CVE-2026-84445,CVE-2026-118651,CVE-2026-118653

# Shared exclusions (all scanners; see 10-security.env)
# Added 2026-10-28 (PR #386, OSV-Scanner):
#  - CVE-2026-118651 / GHSA-99jh-6h7p-pp36 (echo proxy middleware forwards a
#    client-supplied X-Real-IP) and CVE-2026-118653 / GHSA-246p-cpwv-v3jq (echo
#    rate limiter bypass via spoofed X-Forwarded-For) affect
#    github.com/labstack/echo/v4, an indirect-only dependency via
#    bsv-blockchain/teranode/services/p2p. BSV Broadcaster imports only that
#    package's message types (NodeStatusMessage, FeePolicy, FeeAmount) and never
#    builds teranode's echo server or middleware, so neither path is in our
#    binaries. No echo v4 release carries the fix (patched only in v5.1.0 /
#    v5.4.0); remove once teranode moves to echo v5 or drops it.
SECURITY_VULN_EXCLUDES=CVE-2026-118651,GHSA-99jh-6h7p-pp36,CVE-2026-118653,GHSA-246p-cpwv-v3jq

# Skip pre-building packages during cache warming to prevent OOM kills.
# Even batch_size=3 with GOGC=50 exceeds the ~7GB available on standard runners
# because heavy packages (cmd/certifier, cmd/infra) pull in the entire dependency
# tree (libp2p, k8s, googleapis, etc.).
# The module cache (go mod download) is still warmed — that provides the biggest
# speedup. Build artifacts get cached naturally after the first real build job.
MAGE_X_BUILD_STRATEGY=skip
